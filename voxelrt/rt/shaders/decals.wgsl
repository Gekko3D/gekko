struct CameraData { view_proj: mat4x4<f32>, inv_view: mat4x4<f32>, inv_proj: mat4x4<f32>, cam_pos: vec4<f32>, light_pos: vec4<f32>, ambient_color: vec4<f32>, debug_mode: u32, render_mode: u32, num_lights: u32, pad1: u32, screen_size: vec2<f32>, pad2: vec2<u32>, ao_quality: vec4<f32>, distance_limits: vec4<f32>, };
struct DecalInstance { position: vec4<f32>, rotation: vec4<f32>, half_extents: vec4<f32>, color: vec4<f32>, atlas: vec4<u32>, };
@group(0) @binding(0) var<uniform> camera: CameraData;
@group(0) @binding(1) var<storage, read> decals: array<DecalInstance>;
@group(0) @binding(2) var atlas_tex: texture_2d<f32>;
@group(0) @binding(3) var atlas_sampler: sampler;
@group(1) @binding(0) var gbuf_depth: texture_2d<f32>;
@group(1) @binding(1) var gbuf_normal: texture_2d<f32>;
struct VSOut { @builtin(position) position: vec4<f32>, @location(0) world_pos: vec3<f32>, @location(1) @interpolate(flat) iid: u32, };
fn rotate(q: vec4<f32>, v: vec3<f32>) -> vec3<f32> { return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v); }
fn srgb_channel_to_linear(v: f32) -> f32 { if (v <= 0.04045) { return v / 12.92; } return pow((v + 0.055) / 1.055, 2.4); }
fn srgb_to_linear(c: vec3<f32>) -> vec3<f32> { return vec3(srgb_channel_to_linear(c.x), srgb_channel_to_linear(c.y), srgb_channel_to_linear(c.z)); }
fn cube_vertex(i: u32) -> vec3<f32> { let p = array<vec3<f32>, 36>(vec3(-1,-1,-1),vec3(1,-1,-1),vec3(1,1,-1),vec3(-1,-1,-1),vec3(1,1,-1),vec3(-1,1,-1),vec3(-1,-1,1),vec3(1,1,1),vec3(1,-1,1),vec3(-1,-1,1),vec3(-1,1,1),vec3(1,1,1),vec3(-1,-1,-1),vec3(-1,-1,1),vec3(1,-1,1),vec3(-1,-1,-1),vec3(1,-1,1),vec3(1,-1,-1),vec3(-1,1,-1),vec3(1,1,-1),vec3(1,1,1),vec3(-1,1,-1),vec3(1,1,1),vec3(-1,1,1),vec3(-1,-1,-1),vec3(-1,1,-1),vec3(-1,1,1),vec3(-1,-1,-1),vec3(-1,1,1),vec3(-1,-1,1),vec3(1,-1,-1),vec3(1,-1,1),vec3(1,1,1),vec3(1,-1,-1),vec3(1,1,1),vec3(1,1,-1)); return p[i]; }
@vertex fn vs_main(@builtin(vertex_index) vid: u32, @builtin(instance_index) iid: u32) -> VSOut { let d = decals[iid]; let world = d.position.xyz + rotate(d.rotation, cube_vertex(vid) * d.half_extents.xyz); var clip = camera.view_proj * vec4(world, 1.0); clip.z = clip.z * 0.5 + clip.w * 0.5; return VSOut(clip, world, iid); }
@fragment fn fs_main(in: VSOut) -> @location(0) vec4<f32> { let d = decals[in.iid]; let pixel = vec2<i32>(clamp(i32(in.position.x), 0, i32(camera.screen_size.x)-1), clamp(i32(in.position.y), 0, i32(camera.screen_size.y)-1)); let depth = textureLoad(gbuf_depth, pixel, 0).x; if (depth <= 0.0) { discard; } let ndc = vec2<f32>((in.position.x / camera.screen_size.x) * 2.0 - 1.0, 1.0 - (in.position.y / camera.screen_size.y) * 2.0); let near = camera.inv_view * (camera.inv_proj * vec4(ndc, 1.0, 1.0)); let ray = normalize(near.xyz / near.w - camera.cam_pos.xyz); let hit = camera.cam_pos.xyz + ray * depth; let q = vec4(-d.rotation.xyz, d.rotation.w); let local = rotate(q, hit - d.position.xyz); if (any(abs(local) > d.half_extents.xyz)) { discard; } let normal = normalize(textureLoad(gbuf_normal, pixel, 0).xyz); if (dot(normal, rotate(d.rotation, vec3(0.0, 0.0, 1.0))) < d.half_extents.w) { discard; } let uv = local.xy / (2.0 * d.half_extents.xy) + vec2(0.5); let cols = max(1u, d.atlas.y); let rows = max(1u, d.atlas.z); let tile_size = max(vec2<u32>(1u), textureDimensions(atlas_tex) / vec2<u32>(cols, rows)); let tile_origin = vec2<u32>(d.atlas.x % cols, d.atlas.x / cols) * tile_size; let texel = tile_origin + min(vec2<u32>(uv * vec2<f32>(tile_size)), tile_size - vec2<u32>(1u)); let sample = textureLoad(atlas_tex, vec2<i32>(texel), 0) * d.color; let alpha = sample.a; return vec4(srgb_to_linear(sample.rgb) * alpha, alpha); }
